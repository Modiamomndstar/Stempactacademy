  demoUrl                String?
  repoUrl                String?
  mediaUrls              String[]
  skillsDemonstrated     String[]
  isVerifiedByInstructor Boolean          @default(false)
  completedAt            DateTime?
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt
}

// ==========================================
// PHASE 2: DATABASE FOUNDATION ADDITIVE MODELS
// ==========================================

enum EnrollmentStatus {
  ENROLLED
  ACTIVE
  DEFERRED
  COMPLETED
  WITHDRAWN
  SUSPENDED
}

enum FinancialClearanceStatus {
  PENDING
  PARTIAL
  CLEARED
  WAIVED
  REVOKED
}

enum GuardianRelationshipType {
  FATHER
  MOTHER
  GUARDIAN
  SPONSOR
  OTHER
}

model StudentCohortEnrollment {
  id                    String              @id @default(uuid())
  studentId             String
  student               StudentProfile      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  cohortId              String
  cohort                Cohort              @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  admissionId           String?
  admission             Admission?          @relation(fields: [admissionId], references: [id], onDelete: SetNull)
  applicationId         String?
  application           Application?        @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  programId             String?
  program               Program?            @relation(fields: [programId], references: [id], onDelete: SetNull)
  programVersionId      String?
  programVersion        ProgramVersion?     @relation(fields: [programVersionId], references: [id], onDelete: SetNull)
  curriculumVersionId   String?
  curriculumVersion     CurriculumVersion?  @relation(fields: [curriculumVersionId], references: [id], onDelete: SetNull)
  academicSessionId     String?
  academicSession       AcademicSession?    @relation(fields: [academicSessionId], references: [id], onDelete: SetNull)
  enrolledById          String?
  enrolledBy            User?               @relation("EnrollmentEnrolledBy", fields: [enrolledById], references: [id], onDelete: SetNull)
  enrollmentDate        DateTime            @default(now())
  status                EnrollmentStatus    @default(ENROLLED)
  financialClearanceId  String?             @unique
  financialClearance    FinancialClearance? @relation(fields: [financialClearanceId], references: [id], onDelete: SetNull)
  completionDate        DateTime?
  withdrawalReason      String?
  withdrawnAt           DateTime?
  deferralReason        String?
  deferredAt            DateTime?
  notes                 String?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  lessonProgress        StudentLessonProgress[]
  competencies          StudentCompetency[]

  @@unique([studentId, cohortId])
  @@index([studentId])
  @@index([cohortId])
  @@index([admissionId])
  @@index([applicationId])
  @@index([programVersionId])
  @@index([curriculumVersionId])
  @@index([status])
  @@index([enrollmentDate])
}

model FinancialClearance {
  id                         String                    @id @default(uuid())
  studentId                  String?
  student                    StudentProfile?           @relation(fields: [studentId], references: [id], onDelete: SetNull)
  applicationId              String?
  application                Application?              @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  admissionId                String?
  admission                  Admission?                @relation(fields: [admissionId], references: [id], onDelete: SetNull)
  invoiceId                  String?
  invoice                    Invoice?                  @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  status                     FinancialClearanceStatus  @default(PENDING)
  amountRequired             Float
  amountPaid                 Float                     @default(0)
  minimumRequiredPercentage  Float                     @default(100.0) // Configurable threshold (defaults to 100% full payment unless plan approved)
  clearancePercentage        Float                     @default(0)
  approvedPlanType           String?                   @default("FULL") // FULL, INSTALLMENTS, FULL_SCHOLARSHIP, FULL_SPONSORSHIP, CUSTOM_ARRANGEMENT
  requiredInitialPayment     Float?                    // Management-approved minimum payment to achieve enrollment clearance
  installmentScheduleJson    String?                   // JSON audit of approved installment plan milestones
  fundingSource              String?                   @default("SELF") // SELF, PARENT_GUARDIAN, SPONSOR, SCHOLARSHIP, MIXED
  sponsorName                String?
  approvedById               String?
  approvedByUser             User?                     @relation("FinancialClearanceApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt                 DateTime?
  clearedBy                  String?
  clearedById                String?
  clearedByUser              User?                     @relation("FinancialClearanceClearedBy", fields: [clearedById], references: [id], onDelete: SetNull)
  clearedAt                  DateTime?
  waivedById                 String?
  waivedByUser               User?                     @relation("FinancialClearanceWaivedBy", fields: [waivedById], references: [id], onDelete: SetNull)
  waivedAt                   DateTime?
  waiverReason               String?
  waiverAmount               Float?
  notes                      String?
  createdAt                  DateTime                  @default(now())
  updatedAt                  DateTime                  @updatedAt

  enrollment                 StudentCohortEnrollment?

  @@index([studentId])
  @@index([applicationId])
  @@index([admissionId])
  @@index([invoiceId])
  @@index([status])
  @@index([approvedById])
  @@index([createdAt])
}

model StudentGuardianRelation {
  id                           String                   @id @default(uuid())
  studentId                    String
  student                      StudentProfile           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  parentId                     String
  parent                       ParentProfile            @relation(fields: [parentId], references: [id], onDelete: Cascade)
  relationshipType             GuardianRelationshipType @default(GUARDIAN)
  isPrimary                    Boolean                  @default(false)
  canAccessAcademicRecords     Boolean                  @default(true)
  canReceiveBillingInformation Boolean                  @default(true)
  createdAt                    DateTime                 @default(now())
  updatedAt                    DateTime                 @updatedAt

  @@unique([studentId, parentId])
  @@index([studentId])
  @@index([parentId])
}

// ==========================================
// PHASE 3: COLLISION-SAFE IDENTIFIER SEQUENCES
// ==========================================

model IdentifierSequence {
  name       String   @id // e.g. "APP_2026", "ADM_2026", "STP_2026", "INV_2026", "CERT_2026", "COHORT_2026", "INS"
  prefix     String
  year       Int?
  currentVal Int      @default(0)
  updatedAt  DateTime @updatedAt
}

// ==========================================
// PHASE 8: NOTIFICATION, OUTBOX & DELIVERY MODELS
// ==========================================

enum NotificationChannel {
  EMAIL
  IN_APP
  SMS
  WHATSAPP
}

enum DeliveryStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

enum OutboxStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
  DEAD_LETTER
}

model NotificationTemplate {
  id          String              @id @default(uuid())
  code        String              @unique // e.g. "ADMISSION_OFFER", "PAYMENT_RECEIPT", "ACADEMIC_ANNOUNCEMENT"
  name        String
  channel     NotificationChannel @default(EMAIL)
  subject     String?
  body        String              // Template with {{variables}}
  variables   String?             // JSON array of variable names
  isActive    Boolean             @default(true)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
}

model NotificationPreference {
  id                 String   @id @default(uuid())
  userId             String   @unique
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  emailEnabled       Boolean  @default(true)
  inAppEnabled       Boolean  @default(true)
  smsEnabled         Boolean  @default(false)
  whatsappEnabled    Boolean  @default(false)
  academicAlerts     Boolean  @default(true)
  billingAlerts      Boolean  @default(true)
  marketingAlerts    Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model NotificationDelivery {
  id             String              @id @default(uuid())
  notificationId String?
  notification   Notification?       @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  userId         String
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel        NotificationChannel
  recipient      String              // email address, phone number, or userId
  subject        String?
  body           String
  status         DeliveryStatus      @default(PENDING)
  provider       String?             // e.g. "resend", "smtp", "mock", "in_app"
  providerRef    String?             // Provider-returned message ID
  errorMessage   String?
  metadata       String?             // JSON string
  sentAt         DateTime?
  createdAt      DateTime            @default(now())

  @@index([notificationId])
  @@index([userId])
  @@index([status])
  @@index([channel])
}

model EventOutbox {
  id             String       @id @default(uuid())
  eventType      String       // e.g. "ADMISSION_OFFICIAL_OFFER", "PAYMENT_CLEARED", "ENROLLMENT_CONFIRMED"
  aggregateType  String       // e.g. "Admission", "FinancialClearance", "StudentCohortEnrollment"
  aggregateId    String
  idempotencyKey String       @unique
  payload        String       // JSON payload
  status         OutboxStatus @default(PENDING)
  attempts       Int          @default(0)
  maxAttempts    Int          @default(5)
  nextAttemptAt  DateTime     @default(now())
  processedAt    DateTime?
  lastError      String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([status, nextAttemptAt])
  @@index([aggregateType, aggregateId])
}

