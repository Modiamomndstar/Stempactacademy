  amountPaid          Float           @default(0)
  balance             Float
  dueDate             DateTime
  status              InvoiceStatus   @default(UNPAID)
  items               String          // JSON string of breakdown items
  payments            Payment[]
  financialClearances FinancialClearance[]
  createdAt           DateTime        @default(now())

  @@index([studentId])
  @@index([applicationId])
  @@index([admissionId])
  @@index([cohortId])
}

model Payment {
  id               String        @id @default(uuid())
  invoiceId        String
