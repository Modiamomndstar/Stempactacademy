generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ACADEMIC_ADMIN
  FINANCE_ADMIN
  ADMISSIONS_ADMIN
  PROGRAM_COORDINATOR
  COORDINATOR_ADMIN
  INSTRUCTOR
  STUDENT
  PARENT
  COUNSELOR
  CONTENT_MANAGER
  INNOVATION_MANAGER
  MARKETING_MANAGER
  PARTNER
  APPLICANT
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
  DEACTIVATED
  ARCHIVED
}

enum AcademicLevel {
  LEVEL_0_ASSESSMENT
  LEVEL_1_FOUNDATION
  LEVEL_2_INTERMEDIATE
  LEVEL_3_ADVANCED
  LEVEL_4_SPECIALIST
  LEVEL_5_INNOVATION
  LEVEL_6_ENTREPRENEURSHIP
}

enum WorkflowStatus {
  DRAFT
  PENDING_REVIEW
  IN_REVIEW
  CHANGES_REQUESTED
  APPROVED
  PUBLISHED
  REJECTED
  ARCHIVED
}

enum AIActionType {
  PROGRAM_GENERATION
  CURRICULUM_GENERATION
  SYLLABUS_GENERATION
  COURSE_GENERATION
  MODULE_GENERATION
  LESSON_PLAN_GENERATION
  ASSESSMENT_GENERATION
  ASSIGNMENT_GENERATION
  PROJECT_GENERATION
  QUALITY_CHECK
  FEEDBACK_GENERATION
  ADMISSION_LETTER_GENERATION
  PROGRESS_ANALYSIS
  STUDENT_COPILOT
  PARENT_ASSISTANT
  ADMIN_ASSISTANT
}

enum ProgramStatus {
  DRAFT
  AI_GENERATED
  UNDER_REVIEW
  APPROVED
  PUBLISHED
  UPCOMING
  OPEN_FOR_APPLICATION
  FULL
  CLOSED
  ARCHIVED
  REVISED
}

enum CohortStatus {
  DRAFT
  UPCOMING
  OPEN
  ALMOST_FULL
  FULL
  IN_PROGRESS
  COMPLETED
  CLOSED
}

enum ApplicationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  ASSESSMENT_PENDING
  ASSESSED
  PLACEMENT_PENDING
  PLACED
  ADMITTED
  ENROLLED
  REJECTED
  WITHDRAWN
}

enum AttendanceStatus {
  PRESENT
  LATE
  ABSENT
  EXCUSED
}

enum PaymentStatus {
  PENDING
  PARTIALLY_PAID
  PAID
  FAILED
  REFUNDED
}

enum InvoiceStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  CANCELLED
}

enum CertificateType {
  PARTICIPATION
  COMPLETION
  PROFESSIONAL
  ADVANCED_PROFESSIONAL
  SPECIALIST
  INNOVATION
}

enum AdmissionStatus {
  PENDING
  OFFERED
  ISSUED
  ACCEPTED
  DECLINED
  WITHDRAWN
  EXPIRED
  FINANCIALLY_CLEARED
  ENROLLED
}

model User {
  id            String     @id @default(uuid())
  email         String     @unique
  username      String?    @unique
  passwordHash  String
  firstName     String
  lastName      String
  phone         String?
  role          Role       @default(STUDENT)
  status        UserStatus @default(ACTIVE)
  avatarUrl     String?
  isActive      Boolean    @default(true)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  studentProfile     StudentProfile?
  parentProfile      ParentProfile?
  instructorProfile  InstructorProfile?
  coordinatorProfile CoordinatorProfile?
  partnerProfile     PartnerProfile?
  applications       Application[]
  assessmentAttempts AssessmentAttempt[]
  submissions        Submission[]
  attendanceMarked   Attendance[]         @relation("InstructorAttendance")
  assignmentsCreated Assignment[]         @relation("AssignmentInstructor")
  submissionsGraded  Submission[]         @relation("SubmissionGradedBy")
  competenciesEvaluated StudentCompetency[] @relation("CompetencyEvaluator")
  announcements      Announcement[]       @relation("AuthorAnnouncements")
  notifications      Notification[]
  auditLogs          AuditLog[]
  counselorRecords   CounselingRecord[]   @relation("CounselorRecords")
  aiGenerations      AIGeneration[]       @relation("RequestedGenerations")
  reviewedPlacements         Placement[]               @relation("PlacementReviewer")
  placementDecisions         PlacementDecision[]       @relation("PlacementDecisionReviewer")
  admissionsIssued           Admission[]               @relation("AdmissionIssuedBy")
  admissionsWithdrawn        Admission[]               @relation("AdmissionWithdrawnBy")
  enrollmentsCreated         StudentCohortEnrollment[] @relation("EnrollmentEnrolledBy")
  financialClearancesCleared FinancialClearance[]      @relation("FinancialClearanceClearedBy")
  financialClearancesWaived  FinancialClearance[]      @relation("FinancialClearanceWaivedBy")
  financialClearancesApproved FinancialClearance[]     @relation("FinancialClearanceApprovedBy")
  notificationPreference     NotificationPreference?
  notificationDeliveries     NotificationDelivery[]
}

model School {
  id          String    @id @default(uuid())
  code        String    @unique
  name        String
  description String
  icon        String?
  color       String    @default("#2563eb")
  order       Int       @default(0)
  createdAt   DateTime  @default(now())
  programs    Program[]
}

model Program {
  id                   String        @id @default(uuid())
  code                 String        @unique
  name                 String
  schoolId             String
  school               School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  description          String
  targetLearner        String
  entryRequirements    String
  prerequisites        String
  duration             String
  contactHours         Int           @default(48)
  learningLevels       String        // JSON string or summary e.g. "Level 1: Beginner, Level 2: Intermediate, Level 3: Advanced"
  tools                String        // comma-separated or JSON e.g. "VSCode, Python, React, Git"
  projects             String        // summary of hands-on projects
  capstone             String        // capstone description
  assessmentCriteria   String
  competencies         String
  certification        String
  careerPathways       String
  progressionPathway   String
  status               ProgramStatus @default(OPEN_FOR_APPLICATION)
  level                AcademicLevel @default(LEVEL_1_FOUNDATION)
  version              Int           @default(1)
  isFeatured           Boolean       @default(false)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  cohorts              Cohort[]
  applications         Application[]
  courses              Course[]
  competencyList       Competency[]
  assessments          Assessment[]
  projectsList         Project[]
  curricula            Curriculum[]
  syllabi              Syllabus[]
  capstoneProjects     CapstoneProject[]
  versions             ProgramVersion[]
  placements           Placement[]
  placementDecisions   PlacementDecision[]
  attemptRecommendations AssessmentAttempt[]
  admissions           Admission[]
  enrollments          StudentCohortEnrollment[]
}

model Course {
  id                  String             @id @default(uuid())
  programId           String
  program             Program            @relation(fields: [programId], references: [id], onDelete: Cascade)
  curriculumVersionId String?
  curriculumVersion   CurriculumVersion? @relation(fields: [curriculumVersionId], references: [id], onDelete: SetNull)
  code                String
  title               String
  description         String
  credits             Int                @default(3)
  order               Int                @default(0)
  modules             Module[]
  assignments         Assignment[]
  classSessions       ClassSession[]

  @@index([programId])
  @@index([curriculumVersionId])
}

model Module {
  id            String   @id @default(uuid())
  courseId      String
  course        Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title         String
  description   String
  durationHours Int      @default(12)
  order         Int      @default(0)
  lessons       Lesson[]
  practicalActivities PracticalActivity[]
  assignments   Assignment[]
  classSessions ClassSession[]

  @@index([courseId])
}

model Lesson {
  id              String                  @id @default(uuid())
  moduleId        String
  module          Module                  @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  title           String
  content         String
  resources       String?  // links or docs
  order           Int                     @default(0)
  classSessions   ClassSession[]
  studentProgress StudentLessonProgress[]

  @@index([moduleId])
}

model Competency {
  id                  String              @id @default(uuid())
  programId           String
  program             Program             @relation(fields: [programId], references: [id], onDelete: Cascade)
  curriculumVersionId String?
  curriculumVersion   CurriculumVersion?  @relation(fields: [curriculumVersionId], references: [id], onDelete: SetNull)
  code                String
  title               String
  description         String
  category            String              // e.g. "Technical", "Analytical", "Soft Skills"
  studentRecords      StudentCompetency[]

  @@index([programId])
  @@index([curriculumVersionId])
}

model Cohort {
  id                  String              @id @default(uuid())
  cohortCode          String              @unique // e.g. "STP-2025-C1-WD"
  name                String
  programId           String
  program             Program             @relation(fields: [programId], references: [id], onDelete: Cascade)
  programVersionId    String?
  programVersion      ProgramVersion?     @relation(fields: [programVersionId], references: [id], onDelete: SetNull)
  curriculumVersionId String?
  curriculumVersion   CurriculumVersion?  @relation(fields: [curriculumVersionId], references: [id], onDelete: SetNull)
  level               String              @default("Level 1 (Foundation)")
  startDate           DateTime
  endDate             DateTime
  applicationDeadline DateTime
  schedule            String              // e.g. "Mon, Wed, Fri 4:00 PM - 6:30 PM"
  mode                String              @default("Hybrid (Onsite Ile-Ife & Virtual)")
  location            String              @default("STEMPACT Main Hub, Ile-Ife, Osun State")
  instructorName      String              @default("Academy Lead Instructor")
  maxCapacity         Int                 @default(25)
  currentEnrollment   Int                 @default(0)
  trainingFee         Float               @default(65000)
  registrationFee     Float               @default(5000)
  certificationFee    Float               @default(10000)
  discountPercentage  Float               @default(0)
  status              CohortStatus        @default(OPEN)
  academicSessionId   String?
  academicSession     AcademicSession?    @relation(fields: [academicSessionId], references: [id], onDelete: SetNull)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  applications        Application[]
  admissions          Admission[]
  classSessions       ClassSession[]
  studentProfiles     StudentProfile[]
  assignments         Assignment[]
  projects            Project[]
  syllabi             Syllabus[]
  enrollments         StudentCohortEnrollment[]
  recommendedPlacements Placement[]           @relation("PlacementRecommendedCohort")
  approvedPlacements    Placement[]           @relation("PlacementApprovedCohort")
  attemptRecommendations AssessmentAttempt[]  @relation("AttemptRecommendedCohort")
  placementDecisions    PlacementDecision[]
  invoices              Invoice[]

  @@index([programId])
  @@index([programVersionId])
  @@index([curriculumVersionId])
  @@index([academicSessionId])
}

model Application {
  id                  String            @id @default(uuid())
  applicationNumber   String            @unique // e.g. "APP-2025-0104"
  userId              String?
  user                User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  programId           String
  program             Program           @relation(fields: [programId], references: [id], onDelete: Cascade)
  cohortId            String?
  cohort              Cohort?           @relation(fields: [cohortId], references: [id], onDelete: SetNull)
  preferredSchedule   String
  fullName            String
  dateOfBirth         DateTime
  gender              String
  phone               String
  email               String
  address             String
  educationLevel      String
  institution         String?
  previousTraining    String?
  technicalExperience String?
  relevantSkills      String?
  previousProjects    String?
  careerGoals         String
  learningObjectives  String
  statementOfPurpose  String
  isMinor             Boolean           @default(false)
  parentName          String?
  parentPhone         String?
  parentEmail         String?
  parentRelationship  String?
  consentAccepted     Boolean           @default(true)
  requestedPaymentPlan      String?           // e.g. "FULL", "2_INSTALLMENTS", "3_INSTALLMENTS", "4_INSTALLMENTS", "CUSTOM"
  fundingSourcePreference   String?           // e.g. "SELF", "PARENT_GUARDIAN", "SPONSOR", "SCHOLARSHIP", "OTHER"
  sponsorshipDetails        String?           // Sponsor/Partner organization or individual details
  scholarshipRequested      Boolean           @default(false)
  financialAssistanceReason String?           // Stated reason if requesting scholarship or payment plan
  financialNotes            String?           // Optional applicant financial note
  status              ApplicationStatus @default(SUBMITTED)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  assessmentAttempts  AssessmentAttempt[]
  placement           Placement?
  admission           Admission?
  invoices            Invoice[]
  financialClearances FinancialClearance[]
  enrollments         StudentCohortEnrollment[]
}

model Assessment {
  id                   String               @id @default(uuid())
  title                String
  programId            String
  program              Program              @relation(fields: [programId], references: [id], onDelete: Cascade)
  durationMinutes      Int                  @default(30)
  passingScore         Int                  @default(60)
  instructions         String
  currentVersionNumber Int                  @default(1)
  questions            AssessmentQuestion[]
  attempts             AssessmentAttempt[]
  versions             AssessmentVersion[]
}

model AssessmentVersion {
  id                   String             @id @default(uuid())
  assessmentId         String
  assessment           Assessment         @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  versionNumber        Int                @default(1)
  title                String
  instructions         String
  durationMinutes      Int                @default(30)
  passingScore         Int                @default(60)
  status               WorkflowStatus     @default(PUBLISHED)
  isCurrent            Boolean            @default(true)
  questionsSnapshot    Json?
  programVersionId     String?
  programVersion       ProgramVersion?    @relation(fields: [programVersionId], references: [id], onDelete: SetNull)
  curriculumVersionId  String?
  curriculumVersion    CurriculumVersion? @relation(fields: [curriculumVersionId], references: [id], onDelete: SetNull)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  questions            AssessmentQuestion[]
  attempts             AssessmentAttempt[]

  @@unique([assessmentId, versionNumber])
  @@index([assessmentId])
  @@index([programVersionId])
  @@index([curriculumVersionId])
}

model AssessmentQuestion {
  id                  String             @id @default(uuid())
  assessmentId        String
  assessment          Assessment         @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  assessmentVersionId String?
  assessmentVersion   AssessmentVersion? @relation(fields: [assessmentVersionId], references: [id], onDelete: Cascade)
  category            String             // DIGITAL_LITERACY, LOGICAL_REASONING, MATHEMATICS, TECHNICAL_KNOWLEDGE, PROGRAMMING, PROBLEM_SOLVING
  type                String             @default("MULTIPLE_CHOICE") // MULTIPLE_CHOICE, TRUE_FALSE, SHORT_ANSWER, CODE_SNIPPET
  prompt              String
  codeSnippet         String?
  options             String             // JSON array of options
  correctAnswer       String
  explanation         String?
  points              Int                @default(5)
  order               Int                @default(0)

  @@index([assessmentId])
  @@index([assessmentVersionId])
}

model AssessmentAttempt {
  id                             String             @id @default(uuid())
  applicationId                  String
  application                    Application        @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  userId                         String?
  user                           User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  assessmentId                   String
  assessment                     Assessment         @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  assessmentVersionId            String?
  assessmentVersion              AssessmentVersion? @relation(fields: [assessmentVersionId], references: [id], onDelete: SetNull)
  score                          Float
  maxScore                       Float
  percentage                     Float
  categoryScores                 String             // JSON string of scores per category
  answers                        String             // JSON string of student answers
  questionsSnapshot              Json?              // Frozen snapshot of questions, options & points at attempt time
  ruleVersion                    String?            @default("STEMPACT_RULES_V1")
  recommendedProgram             String
  recommendedLevel               String
  recommendedLevelCode           AcademicLevel?
  recommendedProgramId           String?
  recommendedProgramRef          Program?           @relation(fields: [recommendedProgramId], references: [id], onDelete: SetNull)
  recommendedProgramVersionId    String?
  recommendedProgramVersion      ProgramVersion?    @relation(fields: [recommendedProgramVersionId], references: [id], onDelete: SetNull)
  recommendedCurriculumVersionId String?
  recommendedCurriculumVersion   CurriculumVersion? @relation(fields: [recommendedCurriculumVersionId], references: [id], onDelete: SetNull)
  recommendedCohortId            String?
  recommendedCohort              Cohort?            @relation("AttemptRecommendedCohort", fields: [recommendedCohortId], references: [id], onDelete: SetNull)
  recommendationReason           String
  completedAt                    DateTime           @default(now())

  placement                      Placement?
  placementDecisions             PlacementDecision[]
  admissions                     Admission[]

  @@index([applicationId])
  @@index([assessmentId])
  @@index([assessmentVersionId])
  @@index([recommendedProgramId])
  @@index([recommendedProgramVersionId])
  @@index([recommendedCurriculumVersionId])
  @@index([recommendedCohortId])
}

model Placement {
  id                   String             @id @default(uuid())
  applicationId        String             @unique
  application          Application        @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  assessmentAttemptId  String?            @unique
  assessmentAttempt    AssessmentAttempt? @relation(fields: [assessmentAttemptId], references: [id], onDelete: SetNull)
  recommendedProgram   String
  recommendedLevel     String
  reason               String
  approvedProgram      String?
  approvedLevel        String?
  approvedCohortCode   String?
  adminNotes           String?
  reviewerName         String?
  status               String             @default("PENDING_REVIEW") // PENDING_REVIEW, APPROVED, MODIFIED, REJECTED, RETURNED_FOR_REASSESSMENT
  reviewedAt           DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @default(now()) @updatedAt

  programId            String?
  program              Program?           @relation(fields: [programId], references: [id], onDelete: SetNull)
  programVersionId     String?
  programVersion       ProgramVersion?    @relation(fields: [programVersionId], references: [id], onDelete: SetNull)
  curriculumVersionId  String?
  curriculumVersion    CurriculumVersion? @relation(fields: [curriculumVersionId], references: [id], onDelete: SetNull)
  recommendedCohortId  String?
  recommendedCohort    Cohort?            @relation("PlacementRecommendedCohort", fields: [recommendedCohortId], references: [id], onDelete: SetNull)
  approvedCohortId     String?
  approvedCohort       Cohort?            @relation("PlacementApprovedCohort", fields: [approvedCohortId], references: [id], onDelete: SetNull)
  recommendedLevelCode AcademicLevel?
  approvedLevelCode    AcademicLevel?
  ruleVersion          String?            @default("STEMPACT_RULES_V1")
  reviewerId           String?
  reviewer             User?              @relation("PlacementReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)

  decisions            PlacementDecision[]
  admissions           Admission[]

  @@index([programId])
  @@index([programVersionId])
  @@index([curriculumVersionId])
  @@index([recommendedCohortId])
  @@index([approvedCohortId])
  @@index([reviewerId])
}

model PlacementDecision {
  id                          String             @id @default(uuid())
  placementId                 String
  placement                   Placement          @relation(fields: [placementId], references: [id], onDelete: Cascade)
  assessmentAttemptId         String?
  assessmentAttempt           AssessmentAttempt? @relation(fields: [assessmentAttemptId], references: [id], onDelete: SetNull)
  decision                    String             // APPROVED, MODIFIED, REJECTED, RETURNED_FOR_REASSESSMENT
  reviewerId                  String
  reviewer                    User               @relation("PlacementDecisionReviewer", fields: [reviewerId], references: [id], onDelete: Restrict)
  reviewerName                String
  reviewerRole                String
  approvedProgramId           String?
  approvedProgram             Program?           @relation(fields: [approvedProgramId], references: [id], onDelete: SetNull)
  approvedProgramVersionId    String?
  approvedProgramVersion      ProgramVersion?    @relation(fields: [approvedProgramVersionId], references: [id], onDelete: SetNull)
  approvedCurriculumVersionId String?
  approvedCurriculumVersion   CurriculumVersion? @relation(fields: [approvedCurriculumVersionId], references: [id], onDelete: SetNull)
  approvedLevel               String?
  approvedLevelCode           AcademicLevel?
  approvedCohortId            String?
  approvedCohort              Cohort?            @relation(fields: [approvedCohortId], references: [id], onDelete: SetNull)
  notes                       String?
  createdAt                   DateTime           @default(now())

  @@index([placementId])
  @@index([assessmentAttemptId])
  @@index([reviewerId])
  @@index([createdAt])
}

model Admission {
  id                  String             @id @default(uuid())
  admissionNumber     String             @unique // e.g. "ADM-2025-089"
  studentIdNumber     String?            @unique // e.g. "STP-2025-0142", assigned upon enrollment
  applicationId       String             @unique
  application         Application        @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  cohortId            String
  cohort              Cohort             @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  programName         String
  level               String
  schedule            String
  assignedClass       String             @default("Lab 1 - Turing Hall")
  instructorName      String             @default("Engr. Adeyemi & Tech Faculty")
  letterPdfPath       String?
  orientationDate     DateTime?
  acceptanceDeadline  DateTime?
  whatsappGroupUrl    String             @default("https://chat.whatsapp.com/C1ntPtG3qkh1Aguvh5zxN9")
  handbookUrl         String             @default("/resources/STEMPACT_Student_Handbook_2025.pdf")
  status              AdmissionStatus    @default(OFFERED)
  issuedAt            DateTime           @default(now())

  placementId         String?
  placement           Placement?         @relation(fields: [placementId], references: [id], onDelete: SetNull)
  assessmentAttemptId String?
  assessmentAttempt   AssessmentAttempt? @relation(fields: [assessmentAttemptId], references: [id], onDelete: SetNull)
  programId           String?
  program             Program?           @relation(fields: [programId], references: [id], onDelete: SetNull)
  programVersionId    String?
  programVersion      ProgramVersion?    @relation(fields: [programVersionId], references: [id], onDelete: SetNull)
  curriculumVersionId String?
  curriculumVersion   CurriculumVersion? @relation(fields: [curriculumVersionId], references: [id], onDelete: SetNull)
  academicSessionId   String?
  academicSession     AcademicSession?   @relation(fields: [academicSessionId], references: [id], onDelete: SetNull)
  issuedById          String?
  issuedBy            User?              @relation("AdmissionIssuedBy", fields: [issuedById], references: [id], onDelete: SetNull)
  acceptedAt          DateTime?
  declinedAt          DateTime?
  declinedReason      String?
  withdrawnAt         DateTime?
  withdrawnReason     String?
  withdrawnById       String?
  withdrawnBy         User?              @relation("AdmissionWithdrawnBy", fields: [withdrawnById], references: [id], onDelete: SetNull)
  conditions          String?
  notes               String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @default(now()) @updatedAt

  financialClearances FinancialClearance[]
  enrollments         StudentCohortEnrollment[]
  invoices            Invoice[]

  @@index([cohortId])
  @@index([status])
  @@index([placementId])
  @@index([programId])
  @@index([programVersionId])
  @@index([curriculumVersionId])
  @@index([issuedById])
}

model StudentProfile {
  id                String       @id @default(uuid())
  userId            String       @unique
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  studentIdNumber   String       @unique // e.g. "STP-2025-0142"
  guardianId        String?
  guardian          ParentProfile? @relation(fields: [guardianId], references: [id], onDelete: SetNull)
  currentCohortId   String?
  cohort            Cohort?      @relation(fields: [currentCohortId], references: [id], onDelete: SetNull)
  currentLevel      String       @default("Level 1")
  enrollmentDate    DateTime     @default(now())
  completionRate    Float        @default(0)
  attendanceRate    Float        @default(100)
  status            String       @default("ACTIVE") // ACTIVE, GRADUATED, ON_LEAVE

  attendances       Attendance[]
  submissions       Submission[]
  competencies      StudentCompetency[]
  invoices          Invoice[]
  certificates      Certificate[]
  projectMembers    ProjectMember[]
  counselingRecords CounselingRecord[]
  competitionTeams  TeamMember[]
  sponsorships      SponsoredStudent[]
  portfolio         StudentPortfolio?
  enrollments         StudentCohortEnrollment[]
  financialClearances FinancialClearance[]
  guardianRelations   StudentGuardianRelation[]
  lessonProgress      StudentLessonProgress[]
}

model ParentProfile {
  id               String           @id @default(uuid())
  userId           String           @unique
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  relationship     String           @default("Parent/Guardian")
  emergencyContact String?
  address          String?
  students         StudentProfile[]
  guardianRelations StudentGuardianRelation[]
}

model InstructorProfile {
  id             String         @id @default(uuid())
  userId         String         @unique
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  staffCode      String         @unique
  bio            String?
  specialization String
  qualification  String
  assignedSchools String?       // JSON list of school codes
  classSessions  ClassSession[]
}

model ClassSession {
  id           String             @id @default(uuid())
  cohortId     String
  cohort       Cohort             @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  instructorId String?
  instructor   InstructorProfile? @relation(fields: [instructorId], references: [id], onDelete: SetNull)
