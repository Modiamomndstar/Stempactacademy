model Invoice {
  id            String          @id @default(uuid())
  invoiceNumber String          @unique // e.g. "INV-2025-0045"
  studentId     String?
  student       StudentProfile? @relation(fields: [studentId], references: [id], onDelete: SetNull)
  applicationId String?
  application   Application?    @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  admissionId   String?
  admission     Admission?      @relation(fields: [admissionId], references: [id], onDelete: SetNull)
  cohortId      String?
  cohort        Cohort?         @relation(fields: [cohortId], references: [id], onDelete: SetNull)
  title               String
  baseAmount          Float?          // Base tuition/fee before adjustments
  discountAmount      Float           @default(0) // Discounts or coupons applied
  scholarshipAmount   Float           @default(0) // Scholarship award applied
  sponsorAmount       Float           @default(0) // Third-party sponsor coverage applied
  adjustmentsJson     String?         // Structured audit breakdown of adjustments
  payerType           String?         @default("STUDENT") // STUDENT, PARENT, SPONSOR, ORGANIZATION
  payerName           String?
  payerEmail          String?
  sponsorOrganization String?
