# ==============================================================================
# STEMPACT ACADEMY - PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env in your production environment (Koyeb / Render / VPS).

NODE_ENV=production
PORT=5000

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (Supabase or Neon Managed PostgreSQL 16)
# ------------------------------------------------------------------------------
# Example Neon URI: postgresql://stempact_user:pass123@ep-cool-fog-12345.eu-central-1.aws.neon.tech/stempact_db?sslmode=require
# Example Supabase URI: postgresql://postgres:pass123@db.abcdefghijklmnopqrst.supabase.co:5432/postgres?sslmode=require
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# ------------------------------------------------------------------------------
# 2. SECURITY & AUTHENTICATION
# ------------------------------------------------------------------------------
# Generate a strong 64-character random string (e.g. openssl rand -hex 32)
JWT_SECRET=stempact_production_super_secret_jwt_key_2026_change_me_in_prod

# ------------------------------------------------------------------------------
# 3. DOMAIN & CORS CONFIGURATION
# ------------------------------------------------------------------------------
# The public URL where your React frontend is hosted on Vercel / Cloudflare
CLIENT_URL=https://stempactacademy.com

# ------------------------------------------------------------------------------
# 4. TRANSACTIONAL EMAIL INFRASTRUCTURE (Resend)
# ------------------------------------------------------------------------------
# Obtain from https://resend.com/api-keys
RESEND_API_KEY=re_your_live_resend_api_key_here
RESEND_FROM_EMAIL="STEMPACT Academy <admissions@stempactacademy.com>"

# ------------------------------------------------------------------------------
# 5. PAYMENT GATEWAYS (Paystack & Flutterwave)
# ------------------------------------------------------------------------------
# Paystack Live Keys (from https://dashboard.paystack.co/#/settings/developer)
PAYSTACK_SECRET_KEY=sk_live_your_paystack_secret_key
PAYSTACK_PUBLIC_KEY=pk_live_your_paystack_public_key

# Flutterwave Live Keys (from https://dashboard.flutterwave.com/settings/apis)
FLUTTERWAVE_SECRET_KEY=FLWSECK-your_flutterwave_secret_key-X
FLUTTERWAVE_PUBLIC_KEY=FLWPUBK-your_flutterwave_public_key-X
FLUTTERWAVE_SECRET_HASH=your_custom_secret_hash_for_webhooks

# ------------------------------------------------------------------------------
# 6. SUPER ADMIN DEFAULT PROVISIONING
# ------------------------------------------------------------------------------
# The server automatically creates/syncs this Super Admin account on initial boot
SUPER_ADMIN_EMAIL=superadmin@stempactacademy.com
SUPER_ADMIN_PASSWORD=Admin@Stempact2026!
SUPER_ADMIN_FIRSTNAME=Super
SUPER_ADMIN_LASTNAME=Admin
SUPER_ADMIN_USERNAME=superadmin
